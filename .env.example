# Supabase > Connect > "Session pooler" (IPv4, funciona no Render)
# Formato: postgresql://postgres.SEU_PROJECT_ID:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Se a senha tiver caracteres especiais (# @ ! /), codifique-os (ex.: # = %23, @ = %40, ! = %21)
DATABASE_URL=COLE_AQUI_A_STRING_DO_SESSION_POOLER

GEMINI_API_KEY=COLE_AQUI_SUA_CHAVE
